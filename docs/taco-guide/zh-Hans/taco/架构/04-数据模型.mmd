    BUNDLE {
        string format "taco/files"
        int version "1"
        string docId "刷新时保留"
        string title
        string root
        string access "可选 reader"
    }
    FILE {
        string path "以 root 开头"
        string mediaType
        string content
        string sourceHash "SHA-256"
    }
    THREAD {
        string id
        string status "open 或 resolved"
        string anchor "position + quote"
    }
    MESSAGE {
        string author
        string body
        string createdAt
        string deletedAt "删除后保留占位"
    }
    GROUP {
        string id
        string title
        string paths
    }
    NODE {
        string id
        string title
        string after "前置节点"
    }
    REQUIREMENT {
        string path "可以尚未创建"
        string instruction
        boolean optional
    }
    STATUS {
        string path
        string status "todo in_progress complete freeze"
        string updatedAt
    }
