erDiagram
    BUNDLE ||--|{ FILE : "files[]"
    BUNDLE ||--o{ THREAD : "comments[]"
    BUNDLE ||--o| NAVIGATION : navigation
    BUNDLE ||--o| CHECKPOINTS : checkpoints
    THREAD ||--|{ MESSAGE : messages
    THREAD }o--o| FILE : "anchor.path"
    NAVIGATION ||--o{ GROUP : groups
    CHECKPOINTS ||--|{ NODE : nodes
    CHECKPOINTS ||--o{ STATUS : documents
