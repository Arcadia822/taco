    BUNDLE {
        string format "taco/files"
        int version "1"
        string docId "kept on refresh"
        string title
        string root
        string access "optional reader"
    }
    FILE {
        string path "starts with root"
        string mediaType
        string content
        string sourceHash "SHA-256"
    }
    THREAD {
        string id
        string status "open or resolved"
        string anchor "position + quote"
    }
    MESSAGE {
        string author
        string body
        string createdAt
        string deletedAt "placeholder after delete"
    }
    GROUP {
        string id
        string title
        string paths
    }
    NODE {
        string id
        string title
        string after "predecessor nodes"
    }
    REQUIREMENT {
        string path "may not exist yet"
        string instruction
        boolean optional
    }
    STATUS {
        string path
        string status "todo in_progress complete freeze"
        string updatedAt
    }
