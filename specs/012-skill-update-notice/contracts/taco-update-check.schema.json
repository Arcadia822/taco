{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arcadia822/taco/specs/012-skill-update-notice/contracts/taco-update-check.schema.json",
  "title": "taco-update-check/1",
  "description": "skills/taco/scripts/check-update.mjs --json 的 stdout 契约。Agent 依据该对象决定是否在最终回复末尾追加一句更新提示；检查失败时只读 ok/reason，不得阻断主线工作。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkedAt", "ok", "reason", "source", "skill", "cli"],
  "properties": {
    "schema": {
      "description": "契约标识，固定为 taco-update-check/1。",
      "const": "taco-update-check/1"
    },
    "checkedAt": {
      "description": "检查时刻，ISO 8601 UTC 字符串。",
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "description": "远端最新版本与本地已安装版本是否都成功读取。任一项读取失败即为 false；false 时调用方必须静默。",
      "type": "boolean"
    },
    "reason": {
      "description": "ok 为 false 时的机器可读原因；ok 为 true 时为 null。",
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "disabled",
            "git-unavailable",
            "github-api-unavailable",
            "network-unavailable",
            "timeout",
            "installed-version-marker-missing",
            "installed-version-unreadable",
            "remote-tag-unparseable"
          ]
        }
      ]
    },
    "source": {
      "description": "实际生效的远端探测通道；ok 为 false 时为 null。",
      "oneOf": [{ "type": "null" }, { "enum": ["git-ls-remote", "github-releases-api"] }]
    },
    "skill": {
      "description": "taco skill（本体）的版本比较结果。",
      "type": "object",
      "additionalProperties": false,
      "required": ["installed", "latest", "updateAvailable"],
      "properties": {
        "installed": {
          "description": "脚本所在 skill 目录中 VERSION 文件的值（无 v 前缀）；缺失或不可解析为 null。",
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }]
        },
        "latest": {
          "description": "远端最新正式 tag（v<major>.<minor>.<patch>）去掉前缀后的值；未知为 null。",
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }]
        },
        "updateAvailable": {
          "description": "仅当 latest 严格大于 installed 时为 true；无法比较时为 null。",
          "type": ["boolean", "null"]
        }
      }
    },
    "cli": {
      "description": "taco-cli 的版本比较结果；未安装 taco-cli 时为 null。",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed", "latest", "updateAvailable"],
          "properties": {
            "installed": {
              "description": "taco-cli --version 输出中的 binaryVersion；不可解析为 null。",
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }]
            },
            "latest": {
              "description": "远端最新 taco-cli-v<major>.<minor>.<patch> tag 去掉前缀后的值；未知为 null。",
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }]
            },
            "updateAvailable": {
              "description": "仅当 latest 严格大于 installed 时为 true；无法比较时为 null。",
              "type": ["boolean", "null"]
            }
          }
        }
      ]
    }
  }
}
