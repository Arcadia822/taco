{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taco.local/schemas/015-hosted-review-handoff/handoff.schema.json",
  "title": "TACO-33 公开自动保存与人工交接数据契约",
  "description": "设计阶段增量契约；008 发布基线、评论锚点与 CheckpointsState 保持权威。无 guest/owner 鉴权，姓名与监听元数据均为自报。",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "持久游标及乐观并发版本使用十进制字符串，不能经 JavaScript Number 精度转换。"
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "description": "裁剪首尾空格后的自报姓名即作者 id；不代表鉴权，可被他人冒用。"
    },
    "RelativeFilePath": {
      "$ref": "../../008-taco-host-contract/contracts/protocol.schema.json#/$defs/SafePath",
      "description": "文件变更路径相对于 bundle.root；Checkpoint/评论锚点仍用完整 bundle 路径。"
    },
    "CheckpointsOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "../../008-taco-host-contract/contracts/protocol.schema.json#/$defs/CheckpointsState" }
      ]
    },
    "FilePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeType"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "稳定文件 id；同 id 且有 previousPath 才能认作改名。" },
        "path": { "$ref": "#/$defs/RelativeFilePath" },
        "previousPath": { "$ref": "#/$defs/RelativeFilePath" },
        "changeType": { "enum": ["added", "modified", "deleted", "renamed"] },
        "mediaType": { "type": "string", "minLength": 1 },
        "content": { "type": ["string", "null"], "description": "UTF-8 正文或 PNG data URI；大文件改用 uploadId。" },
        "uploadId": { "$ref": "#/$defs/Uuid", "description": "仅非删除操作可引用已提交、与当前 Taco 绑定的私有文件上传。" }
      },
      "allOf": [
        {
          "if": { "properties": { "changeType": { "const": "deleted" } }, "required": ["changeType"] },
          "then": { "required": ["content"], "properties": { "content": { "type": "null" } }, "not": { "required": ["uploadId"] }, "description": "服务端还须校验结果 files 至少含一份文件；删除最后一份返回 422。" },
          "else": {
            "required": ["mediaType"],
            "oneOf": [
              { "required": ["content"], "properties": { "content": { "type": "string" } }, "not": { "required": ["uploadId"] } },
              { "required": ["uploadId"], "not": { "required": ["content"] } }
            ]
          }
        },
        {
          "if": { "properties": { "changeType": { "const": "renamed" } }, "required": ["changeType"] },
          "then": { "required": ["id", "previousPath"] },
          "else": { "not": { "required": ["previousPath"] } }
        }
      ]
    },
    "AutoSavePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "expectedStateVersion", "author", "fileChanges"],
      "properties": {
        "protocol": { "const": "taco-state/1" },
        "expectedStateVersion": { "$ref": "#/$defs/Sequence" },
        "author": { "$ref": "#/$defs/Name" },
        "fileChanges": { "type": "array", "items": { "$ref": "#/$defs/FilePatch" } },
        "checkpoints": { "$ref": "#/$defs/CheckpointsOrNull", "description": "存在该字段表示替换共享 Checkpoint 图与状态；null 表示明确移除，缺失表示不修改。" }
      },
      "anyOf": [
        { "properties": { "fileChanges": { "minItems": 1 } } },
        { "required": ["checkpoints"] }
      ]
    },
    "ChangedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeType", "mediaType", "content", "diff"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/RelativeFilePath" },
        "previousPath": { "$ref": "#/$defs/RelativeFilePath" },
        "changeType": { "enum": ["added", "modified", "deleted", "renamed"] },
        "mediaType": { "type": "string", "minLength": 1 },
        "content": { "type": ["string", "null"], "description": "删除为 null；其它变更为该次交接已保存的完整正文或 PNG data URI。" },
        "diff": { "type": ["string", "null"], "description": "changedFiles 基于 publish，incrementalFiles 基于上次交接；二进制为 null。" }
      },
      "allOf": [
        {
          "if": { "properties": { "changeType": { "const": "renamed" } }, "required": ["changeType"] },
          "then": { "required": ["id", "previousPath"] },
          "else": { "not": { "required": ["previousPath"] } }
        },
        {
          "if": { "properties": { "changeType": { "const": "deleted" } }, "required": ["changeType"] },
          "then": { "properties": { "content": { "type": "null" } } },
          "else": { "properties": { "content": { "type": "string" } } }
        }
      ]
    },
    "CheckpointChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "from", "to"],
      "properties": {
        "path": { "$ref": "../../008-taco-host-contract/contracts/protocol.schema.json#/$defs/SafePath" },
        "from": { "enum": ["todo", "in_progress", "complete", "freeze", null] },
        "to": { "enum": ["todo", "in_progress", "complete", "freeze", null] }
      }
    },
    "CheckpointDefinitionDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/CheckpointsOrNull" },
        "to": { "$ref": "#/$defs/CheckpointsOrNull" }
      },
      "description": "从基线到当前的完整模板/节点/成员定义差异；状态变化还需看 CheckpointChange。"
    },
    "CommentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "body", "createdAt", "deletedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/$defs/Name" },
        "body": { "type": ["string", "null"], "description": "删除消息为 null，不回填原文。" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "CommentThread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "anchor", "isAnchorStale", "createdAt", "updatedAt", "messages", "actions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] },
        "anchor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "../../008-taco-host-contract/contracts/protocol.schema.json#/$defs/Anchor" }
          ]
        },
        "isAnchorStale": { "type": "boolean", "description": "删除/改名或范围变化使锚点失效时为 true，评论仍保留。" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CommentMessage" } },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "从创建至当前高水位的不可变线程动作史；解决后重开仍保留两条独立记录。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "type", "author", "occurredAt"],
            "properties": {
              "sequence": { "$ref": "#/$defs/Sequence" },
              "type": { "enum": ["create", "reply", "resolve", "reopen", "delete"] },
              "author": { "$ref": "#/$defs/Name" },
              "occurredAt": { "type": "string", "format": "date-time" },
              "messageId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "HandoffPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "changedFiles", "incrementalFiles", "checkpointChanges", "incrementalCheckpointChanges", "checkpoints", "checkpointDefinitionDelta", "incrementalCheckpointDefinitionDelta", "comments", "commentsThroughSequence"],
      "properties": {
        "root": { "$ref": "../../008-taco-host-contract/contracts/protocol.schema.json#/$defs/SafeRootPath" },
        "changedFiles": { "type": "array", "description": "上次 Agent publish 的不可变基线到本次已保存最新状态的累计文件差异。", "items": { "$ref": "#/$defs/ChangedFile" } },
        "incrementalFiles": { "type": "array", "description": "上次成功交接到本次状态的增量；首次以 publish 为基线。恢复 publish 原状仍须出现。", "items": { "$ref": "#/$defs/ChangedFile" } },
        "checkpointChanges": { "type": "array", "description": "publish 基线到当前的文档状态变化。", "items": { "$ref": "#/$defs/CheckpointChange" } },
        "incrementalCheckpointChanges": { "type": "array", "description": "上次交接到当前的状态变化。", "items": { "$ref": "#/$defs/CheckpointChange" } },
        "checkpoints": { "$ref": "#/$defs/CheckpointsOrNull", "description": "当时已保存的完整 Checkpoint 状态与定义。" },
        "checkpointDefinitionDelta": { "$ref": "#/$defs/CheckpointDefinitionDelta", "description": "发布基线到当前定义；无变化时 from/to 等值。" },
        "incrementalCheckpointDefinitionDelta": { "$ref": "#/$defs/CheckpointDefinitionDelta", "description": "上次交接到当前定义；无变化时 from/to 等值。" },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/CommentThread" } },
        "commentsThroughSequence": { "$ref": "#/$defs/Sequence" }
      }
    },
    "HandoffRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tacoId", "author", "createdAt", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "tacoId": { "$ref": "#/$defs/Uuid" },
        "author": { "$ref": "#/$defs/Name" },
        "createdAt": { "type": "string", "format": "date-time" },
        "payload": { "$ref": "#/$defs/HandoffPayload" }
      }
    },
    "HandoffEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sequence", "tacoId", "type", "occurredAt", "actor", "data"],
      "properties": {
        "kind": { "const": "event" },
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "$ref": "#/$defs/Sequence" },
        "tacoId": { "$ref": "#/$defs/Uuid" },
        "type": { "const": "review.handed_off" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/Name" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handoffId"],
          "properties": { "handoffId": { "$ref": "#/$defs/Uuid" } }
        }
      }
    }
  }
}
