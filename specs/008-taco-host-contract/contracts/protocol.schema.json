{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taco.local/schemas/008-taco-host-contract/protocol.schema.json",
  "title": "TacoHostProtocol",
  "description": "Taco Host 交互协议规范 JSON Schema，定义传输帧、快照投影、导入评论、评审变更与流式事件",
  "oneOf": [{ "$ref": "#/$defs/ClientFrame" }, { "$ref": "#/$defs/ServerFrame" }],
  "$defs": {
    "SafePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![a-zA-Z]:)(?!(?:\\.{1,2}(?:/|$)))[^/\\\\\\0]+(?:/(?!(?:\\.{1,2}(?:/|$)))[^/\\\\\\0]+)*$",
      "description": "安全相对文件路径。严禁以斜杠开头、包含反斜杠或空字符、包含空段、点或双点遍历段（. 或 ..），以及驱动器盘符前缀（如 C:）"
    },
    "SafeRootPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?![a-zA-Z]:)(?!(?:\\.{1,2}(?:/|$)))[^/\\\\\\0]+(?:/(?!(?:\\.{1,2}(?:/|$)))[^/\\\\\\0]+)*)$",
      "description": "安全相对根目录路径。允许单点 '.' 表示当前根，或不带遍历段与驱动器前缀的安全相对目录路径"
    },
    "CheckpointDocumentRef": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/SafePath" },
        "optional": { "type": "boolean" }
      }
    },
    "CheckpointNode": {
      "type": "object",
      "required": ["id", "title", "after", "documents"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/CheckpointDocumentRef" }
        }
      }
    },
    "DocumentStatusRecord": {
      "type": "object",
      "required": ["path", "status", "updatedAt"],
      "properties": {
        "path": { "$ref": "#/$defs/SafePath" },
        "status": { "enum": ["todo", "in_progress", "complete", "freeze"] },
        "updatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    },
    "CheckpointsState": {
      "type": "object",
      "description": "Checkpoint DAG and path-keyed status table. Root membership, unique IDs/paths, references, and cycles are validated by validateCheckpoints at runtime.",
      "required": ["version", "nodes", "documents"],
      "properties": {
        "version": { "const": 1 },
        "template": { "type": "string" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/CheckpointNode" } },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/DocumentStatusRecord" } }
      }
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "服务器生成的小写 RFC 4122 UUIDv4 标识符（带连字符），非自增序号，非带前缀 ID",
      "examples": ["8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001", "993b05fd-2f80-48cc-aafd-1d7564781001"]
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "严格单调递增的非负规范十进制字符串序号。为了避免 JavaScript 64 位双精度浮点数丢失精度，协议与持久化均使用字符串传输",
      "examples": ["0", "42", "10050"]
    },
    "Anchor": {
      "type": "object",
      "description": "正文引用锚点。包含关联文件相对路径、文本起止字符偏移量以及上下文精确引文；可选关联具体代码块。全局讨论时字段值为 null",
      "required": ["path", "position", "quote"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/SafePath",
          "description": "被引用文件的相对路径（安全相对路径，不得以斜杠开头，不得包含反斜杠或空字符，拒绝空段、遍历段及驱动器前缀）"
        },
        "position": {
          "type": "object",
          "description": "基于 UTF-16 字符计数的起止偏移量区间 [start, end)。严格要求 end > start >= 0，且必须仅使用 UTF-16 code unit 偏移量",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "description": "起始字符偏移量，非负整数（基于 UTF-16 code unit）"
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "description": "结束字符偏移量，严格大于 start（基于 UTF-16 code unit）"
            }
          }
        },
        "quote": {
          "type": "object",
          "description": "用于抗内容漂移与文本对齐的三元引文结构",
          "required": ["exact", "prefix", "suffix"],
          "additionalProperties": false,
          "properties": {
            "exact": {
              "type": "string",
              "minLength": 1,
              "description": "锚点精确引用的正文片断，不可为空字符串"
            },
            "prefix": {
              "type": "string",
              "description": "精确引文前邻近的上下文文本，允许为空字符串"
            },
            "suffix": {
              "type": "string",
              "description": "精确引文后邻近的上下文文本，允许为空字符串"
            }
          }
        },
        "block": {
          "type": "object",
          "description": "可选关联的代码块或特定结构化块",
          "required": ["id", "type", "language"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "代码块的稳定唯一标识符"
            },
            "type": {
              "type": "string",
              "const": "codeBlock",
              "description": "当前协议仅支持 codeBlock 类型的代码块结构"
            },
            "language": {
              "type": "string",
              "description": "代码块编程语言标识，如 typescript、json、rust 等"
            },
            "nodeId": {
              "type": "string",
              "description": "图表或流程图节点的标识符"
            },
            "nodeLabel": {
              "type": "string",
              "description": "图表节点的显示标签"
            },
            "lineNumber": {
              "type": "integer",
              "minimum": 1,
              "description": "代码块内的行号（1-based）"
            },
            "lineText": {
              "type": "string",
              "description": "对应行号处的原始代码文本"
            }
          }
        }
      },
      "examples": [
        {
          "path": "specs/example/spec.md",
          "position": {
            "start": 120,
            "end": 145
          },
          "quote": {
            "exact": "Host 不做长期 canonical 数据源",
            "prefix": "评审是主要场景；",
            "suffix": "。所有内容默认 public"
          }
        }
      ]
    },
    "Snapshot": {
      "type": "object",
      "description": "只读文档快照投影。由本地 .taco.html 安全投影生成。普通 HTML/HTM 源文件与旧 sourceUrl 字段一律拒绝；collab 凭据等已知敏感数据在投影时被剥离；未知扩展字段一律被拒绝发布并指出 JSON 路径，严禁服务端静默删除。严禁包含 credentials、access、packOptions 或任意未知字段",
      "required": ["format", "version", "docId", "title", "root", "files"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "const": "taco/files",
          "description": "文档格式协议名，固定为 taco/files"
        },
        "version": {
          "type": "integer",
          "const": 1,
          "description": "协议主版本号。Host 发布校验拒绝任何大于 1 的未知协议版本，不进行降级猜测"
        },
        "docId": {
          "type": "string",
          "minLength": 1,
          "description": "输入来源文档 ID，仅作溯源标识，不代替 Host 生成的 Taco UUID"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "当前快照的标题，用于页面与版本展示"
        },
        "root": {
          "$ref": "#/$defs/SafeRootPath",
          "description": "所有文件共同的根相对目录路径。允许为 '.' 或不逃逸的安全相对路径，不得为绝对路径或包含非法遍历符及驱动器盘符"
        },
        "files": {
          "type": "array",
          "description": "快照包含的所有文件列表。最大允许 2,000 个文件",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["path", "mediaType", "content"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "文件稳定标识符。若未提供，必须在计算哈希之前由客户端生成，或仅作为只读展示层标识，严禁服务端在计算哈希后原地变异快照数据结构"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "文件的人类可读标题"
              },
              "path": {
                "$ref": "#/$defs/SafePath",
                "description": "文件完整相对路径，必须以 root + '/' 为前缀且不逃逸根目录（当 root 为 '.' 时必须为有效安全相对路径）"
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "description": "MIME 类型。常用包括 text/markdown、text/html、image/png、application/json、text/yaml、text/vnd.mermaid 等"
              },
              "content": {
                "type": "string",
                "description": "文件内容。对于文本格式为原始 UTF-8 字符串；对于 image/png，为带有 data:image/png;base64, 前缀的 Data URL，解码后二进制大小不得超过 10 MiB。HTML 内容仅作纯文本源码展示，服务端严禁同源执行"
              },
              "sourceHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "可选源文件内容的 SHA-256 哈希值，必须为 64 位小写十六进制字符串"
              },
              "blocks": {
                "type": "array",
                "description": "可选承接既有协议允许的代码块及锚点结构，HTML 长度受 MAX_BLOCK_HTML 限制，不执行任何外部脚本",
                "items": {
                  "type": "object",
                  "required": ["id", "type", "html"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "代码块或视图块标识符"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "paragraph",
                        "heading",
                        "blockquote",
                        "codeBlock",
                        "bulletList",
                        "orderedList",
                        "taskList",
                        "horizontalRule",
                        "image",
                        "table",
                        "documentProperties",
                        "centeredBlock"
                      ],
                      "description": "受支持的静态渲染块类型，必须严格对齐本地内核 SUPPORTED_BLOCK_TYPES"
                    },
                    "html": {
                      "type": "string",
                      "maxLength": 524288,
                      "description": "预渲染静态 HTML，受安全标签与属性白名单审查。Schema maxLength 计 Unicode 码点；另外必须按现有内核验证 UTF-16 code unit 数不超过 524288，这不是 UTF-8 字节上限"
                    }
                  }
                }
              }
            }
          }
        },
        "navigation": {
          "type": "object",
          "description": "可选目录导航清单。保留 version、entry 与 groups，必须逐项校验且不得静默丢弃",
          "required": ["version", "groups"],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "description": "导航配置版本号，固定为 1"
            },
            "entry": {
              "type": "string",
              "description": "默认入口文件的相对路径"
            },
            "groups": {
              "type": "array",
              "description": "导航分组列表",
              "items": {
                "type": "object",
                "required": ["id", "title", "paths"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "分组唯一标识"
                  },
                  "title": {
                    "type": "string",
                    "description": "分组显示标题"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "该分组包含的文件路径清单"
                  }
                }
              }
            }
          }
        },
        "checkpoints": {
          "$ref": "#/$defs/CheckpointsState",
          "description": "可选 Checkpoint 定义和文档状态；无文件哈希校验，非法状态拒绝发布而非静默剥离"
        }
      },
      "examples": [
        {
          "format": "taco/files",
          "version": 1,
          "docId": "local-doc-id",
          "title": "设计评审",
          "root": "specs/example",
          "files": [
            {
              "path": "specs/example/spec.md",
              "mediaType": "text/markdown",
              "content": "## 目标\n正文\n",
              "sourceHash": "c07b955c9aff9b16e3531cc57ec09506f8309d7c055c5606dd13c46950b30569"
            }
          ],
          "navigation": {
            "version": 1,
            "entry": "specs/example/spec.md",
            "groups": [
              {
                "id": "spec",
                "title": "需求",
                "paths": ["specs/example/spec.md"]
              }
            ]
          }
        }
      ]
    },
    "ImportedThread": {
      "type": "object",
      "description": "从本地 .taco.html 导入的历史评论线程。接收既有协议字段，包括已删除消息的墓碑（deletedAt）。导入线程中的作者一律标记为 unverified/imported，且不触发当前版本的反馈完成与确认状态",
      "required": ["id", "anchor", "status", "messages", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "本地线程标识符"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor",
          "description": "评论锚点。规范本地协议中导入的评论锚点必须为非空的规范本地 Anchor 结构"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "线程当前状态：open（开启）或 resolved（已解决）"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "线程创建时间（RFC 3339 UTC）"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "线程最后更新时间（RFC 3339 UTC）"
        },
        "messages": {
          "type": "array",
          "description": "线程内的消息列表，按时间顺序排列",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "author", "body", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "本地消息标识符"
              },
              "author": {
                "type": "string",
                "description": "本地记录的作者显示名称"
              },
              "authorId": {
                "type": "string",
                "description": "本地作者标识符（服务端仅作记录，不与 Host 实名 User 绑定）"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "description": "消息正文文本，非空字符串。单条上限由 JSON Schema 校验 16,384 字符；实际传输与存储以 16 KiB UTF-8 字节限制为独立语义边界"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "消息创建时间（RFC 3339 UTC）"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "消息修改时间（RFC 3339 UTC）"
              },
              "deletedAt": {
                "type": "string",
                "format": "date-time",
                "description": "消息墓碑删除时间标记。若存在则表明消息已删除"
              }
            },
            "dependentSchemas": {
              "deletedAt": {
                "properties": {
                  "body": {
                    "const": "[Deleted message]"
                  }
                }
              }
            }
          }
        }
      },
      "examples": [
        {
          "id": "th_imported_01",
          "anchor": {
            "path": "specs/example/spec.md",
            "position": {
              "start": 0,
              "end": 8
            },
            "quote": {
              "exact": "## 目标\n正文",
              "prefix": "",
              "suffix": ""
            }
          },
          "status": "open",
          "createdAt": "2026-09-17T08:00:00Z",
          "updatedAt": "2026-09-17T08:00:00Z",
          "messages": [
            {
              "id": "msg_01",
              "author": "Alice (Local)",
              "body": "请补充架构拓扑图",
              "createdAt": "2026-09-17T08:00:00Z"
            }
          ]
        }
      ]
    },
    "Actor": {
      "type": "object",
      "description": "操作行为人身份信息。服务端由 ApiKey 或访客会话分配，严禁客户端伪造。当前协议下所有匿名 User 与 guest 的 verified 字段固定为 false",
      "required": ["kind", "id", "displayName", "verified"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "guest"],
          "description": "行为人类型：user（持有 ApiKey 的注册或匿名用户）或 guest（通过网页访客 cookie 鉴权）"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "公开稳定主体标识（User ID 或 Guest public principal ID），绝不是 cookie/session secret"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "显示昵称"
        },
        "verified": {
          "type": "boolean",
          "const": false,
          "description": "实名/OAuth 认证状态。首版协议中所有匿名 User 及 guest 均固定为 false"
        }
      },
      "examples": [
        {
          "kind": "guest",
          "id": "g_7",
          "displayName": "评审者",
          "verified": false
        },
        {
          "kind": "user",
          "id": "u_anon_123",
          "displayName": "发布者 (匿名)",
          "verified": false
        }
      ]
    },
    "ReviewMutation": {
      "type": "object",
      "description": "评审写入操作（可辨别联合类型）。提交到 POST /v1/tacos/{id}/reviews，必须携带 revisionId。类型包括评论创建/回复、线程解决/重开、评审反馈完成、版本确认与撤销确认",
      "oneOf": [
        {
          "description": "comment.created: 新建讨论线程，必须提供正文 body 及锚点 anchor（全局讨论 anchor 为 null）",
          "required": ["revisionId", "type", "body", "anchor"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "comment.created" },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "description": "评论消息正文，单条上限 16 KiB"
            },
            "anchor": {
              "description": "引用锚点，若为全局讨论则传 null",
              "oneOf": [{ "$ref": "#/$defs/Anchor" }, { "type": "null" }]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "comment.replied: 回复已有讨论线程，必须提供目标 threadId 及正文 body，禁止提供 anchor",
          "required": ["revisionId", "type", "threadId", "body"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "comment.replied" },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "description": "目标讨论线程的 ID"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "description": "回复正文，单条上限 16 KiB"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "thread.resolved: 将讨论线程标记为已解决，仅允许线程 owner 或 Taco owner 操作，需指定 threadId",
          "required": ["revisionId", "type", "threadId"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "thread.resolved" },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "description": "目标讨论线程的 ID"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "thread.reopened: 重新打开已解决的讨论线程，需指定 threadId",
          "required": ["revisionId", "type", "threadId"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "thread.reopened" },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "description": "目标讨论线程的 ID"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "review.completed: 提交本次评审反馈完成。该行为不接受 body/threadId/anchor；之后同参与者新增评论时状态自动失效",
          "required": ["revisionId", "type"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "review.completed" }
          },
          "additionalProperties": false
        },
        {
          "description": "revision.approved: 批准/确认当前 Revision。不接受 body/threadId/anchor，新版本需重新确认",
          "required": ["revisionId", "type"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "revision.approved" }
          },
          "additionalProperties": false
        },
        {
          "description": "revision.approval_withdrawn: 撤回当前参与者对当前 Revision 的批准/确认",
          "required": ["revisionId", "type"],
          "properties": {
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "type": { "type": "string", "const": "revision.approval_withdrawn" }
          },
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "revisionId": "993b05fd-2f80-48cc-aafd-1d7564781001",
          "type": "comment.created",
          "body": "这里的边界需要说明",
          "anchor": null
        },
        {
          "revisionId": "993b05fd-2f80-48cc-aafd-1d7564781001",
          "type": "comment.replied",
          "threadId": "th_9",
          "body": "已在下一节补充说明"
        },
        {
          "revisionId": "993b05fd-2f80-48cc-aafd-1d7564781001",
          "type": "review.completed"
        }
      ]
    },
    "Event": {
      "type": "object",
      "description": "Taco 统一事件流记录。共享递增 Sequence，包含评审变更、版本发布以及生命周期关闭事件",
      "required": [
        "kind",
        "id",
        "sequence",
        "tacoId",
        "revisionId",
        "type",
        "occurredAt",
        "actor",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "event",
          "description": "固定为 event，用于区隔控制帧与心跳帧"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "事件唯一标识符，如 ev_42"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "严格单调递增的正整数规范十进制字符串序号（sequence > 0）。注意：恢复游标 Sequence 允许为 0，而已提交事件流 sequence 严格大于 0"
        },
        "tacoId": {
          "$ref": "#/$defs/Uuid"
        },
        "revisionId": {
          "description": "关联的 Revision UUID。对于内容与评审事件必填；对于 Taco 空间生命周期事件（如 taco.closed）该字段为 null",
          "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }]
        },
        "type": {
          "type": "string",
          "enum": [
            "comment.created",
            "comment.replied",
            "thread.resolved",
            "thread.reopened",
            "review.completed",
            "revision.approved",
            "revision.approval_withdrawn",
            "revision.published",
            "taco.closed"
          ],
          "description": "事件类别"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "description": "事件发生时间（由服务器生成的 RFC 3339 UTC 时间戳）"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "data": {
          "type": "object",
          "description": "具体事件类型承载的数据负载"
        }
      },
      "oneOf": [
        {
          "description": "comment.created: 新建讨论事件",
          "properties": {
            "type": { "const": "comment.created" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "required": ["threadId", "messageId", "body", "anchor"],
              "additionalProperties": false,
              "properties": {
                "threadId": { "type": "string", "minLength": 1 },
                "messageId": { "type": "string", "minLength": 1 },
                "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
                "anchor": {
                  "oneOf": [{ "$ref": "#/$defs/Anchor" }, { "type": "null" }]
                }
              }
            }
          }
        },
        {
          "description": "comment.replied: 回复讨论事件",
          "properties": {
            "type": { "const": "comment.replied" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "required": ["threadId", "messageId", "body"],
              "additionalProperties": false,
              "properties": {
                "threadId": { "type": "string", "minLength": 1 },
                "messageId": { "type": "string", "minLength": 1 },
                "body": { "type": "string", "minLength": 1, "maxLength": 16384 }
              }
            }
          }
        },
        {
          "description": "thread.resolved: 线程标记解决事件",
          "properties": {
            "type": { "const": "thread.resolved" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "required": ["threadId"],
              "additionalProperties": false,
              "properties": {
                "threadId": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "description": "thread.reopened: 线程重开事件",
          "properties": {
            "type": { "const": "thread.reopened" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "required": ["threadId"],
              "additionalProperties": false,
              "properties": {
                "threadId": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "description": "review.completed: 评审反馈完成事件，负载无额外字段",
          "properties": {
            "type": { "const": "review.completed" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "maxProperties": 0,
              "description": "反馈完成操作无需额外负载"
            }
          }
        },
        {
          "description": "revision.approved: 版本确认/批准事件，负载无额外字段",
          "properties": {
            "type": { "const": "revision.approved" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "maxProperties": 0,
              "description": "确认操作无需额外负载"
            }
          }
        },
        {
          "description": "revision.approval_withdrawn: 撤回版本确认事件，负载无额外字段",
          "properties": {
            "type": { "const": "revision.approval_withdrawn" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "data": {
              "type": "object",
              "maxProperties": 0,
              "description": "撤回确认无需额外负载"
            }
          }
        },
        {
          "description": "revision.published: 新版本发布系统事件。actor 必须为持有 ApiKey 的 user",
          "properties": {
            "type": { "const": "revision.published" },
            "revisionId": { "$ref": "#/$defs/Uuid" },
            "actor": {
              "properties": {
                "kind": { "const": "user" }
              }
            },
            "data": {
              "type": "object",
              "required": ["contentHash", "parentRevisionId"],
              "additionalProperties": false,
              "properties": {
                "contentHash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "description": "新版本的 JCS SHA-256 摘要，格式为 sha256:<64位小写十六进制>"
                },
                "parentRevisionId": {
                  "description": "父版本 UUID，初次发布时为 null，必填字段",
                  "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }]
                }
              }
            }
          }
        },
        {
          "description": "taco.closed: Taco 空间关闭为只读的系统事件。revisionId 固定为 null，actor 限制为 user（持有 ApiKey 的 Taco 所有者）",
          "properties": {
            "type": { "const": "taco.closed" },
            "revisionId": { "type": "null" },
            "actor": {
              "properties": {
                "kind": { "const": "user" }
              }
            },
            "data": {
              "type": "object",
              "maxProperties": 0,
              "description": "空间关闭事件无需额外负载"
            }
          }
        }
      ],
      "examples": [
        {
          "kind": "event",
          "id": "ev_42",
          "sequence": "42",
          "tacoId": "8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001",
          "revisionId": "993b05fd-2f80-48cc-aafd-1d7564781001",
          "type": "comment.created",
          "occurredAt": "2026-09-17T10:00:00Z",
          "actor": {
            "kind": "guest",
            "id": "g_7",
            "displayName": "评审者",
            "verified": false
          },
          "data": {
            "threadId": "th_9",
            "messageId": "m_9",
            "body": "这里的边界需要说明",
            "anchor": null
          }
        },
        {
          "kind": "event",
          "id": "ev_43",
          "sequence": "43",
          "tacoId": "8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001",
          "revisionId": null,
          "type": "taco.closed",
          "occurredAt": "2026-09-17T10:05:00Z",
          "actor": {
            "kind": "user",
            "id": "u_anon_123",
            "displayName": "发布者 (匿名)",
            "verified": false
          },
          "data": {}
        }
      ]
    },
    "ClientFrame": {
      "type": "object",
      "description": "WebSocket 客户端首帧。连接建立后必须在 10 秒内发送，指定协议与恢复游标。注意：WebSocket 保活使用应用级纯文本 'ping' / 'pong' 消息，而非原生底层 WS 控制帧，且不走 JSON 帧",
      "required": ["type", "protocol", "after"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "subscribe",
          "description": "订阅请求指令，固定为 subscribe"
        },
        "protocol": {
          "type": "string",
          "const": "taco-host/1",
          "description": "协议标识，固定为 taco-host/1"
        },
        "after": {
          "description": "从指定 sequence 之后开始接收事件。首次订阅传 null；恢复连接时传入上一次已处理的 sequence 字符串",
          "oneOf": [{ "$ref": "#/$defs/Sequence" }, { "type": "null" }]
        }
      },
      "examples": [
        {
          "type": "subscribe",
          "protocol": "taco-host/1",
          "after": null
        },
        {
          "type": "subscribe",
          "protocol": "taco-host/1",
          "after": "41"
        }
      ]
    },
    "ServerFrame": {
      "type": "object",
      "description": "WebSocket 服务端推送帧。包括就绪帧（ready）、事件帧（event）、检查点帧（checkpoint）与协议错误帧（error）。注意：文本心跳 ping/pong 在应用传输层处理，不属于 JSON 帧",
      "oneOf": [
        {
          "description": "ready (live mode): 实时模式就绪帧。客户端首次订阅且 after 为 null 时下发，cursor 为注册时捕获的高水位 H，后续仅推送 > H 的实时事件；历史记录通过 HTTP API 查询。禁止包含 replayThrough 字段",
          "required": ["kind", "protocol", "tacoId", "cursor", "mode"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "ready" },
            "protocol": { "type": "string", "const": "taco-host/1" },
            "tacoId": { "$ref": "#/$defs/Uuid" },
            "cursor": { "$ref": "#/$defs/Sequence" },
            "mode": { "type": "string", "const": "live" }
          }
        },
        {
          "description": "ready (replay mode): 补读/重放模式就绪帧。客户端指定了有效的 after 时下发，cursor 为客户端当前确认游标，replayThrough 为补读截止的高水位 H。顺序补发 (after, replayThrough] 后发送 checkpoint 帧切换到实时流",
          "required": ["kind", "protocol", "tacoId", "cursor", "mode", "replayThrough"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "ready" },
            "protocol": { "type": "string", "const": "taco-host/1" },
            "tacoId": { "$ref": "#/$defs/Uuid" },
            "cursor": { "$ref": "#/$defs/Sequence" },
            "mode": { "type": "string", "const": "replay" },
            "replayThrough": { "$ref": "#/$defs/Sequence" }
          }
        },
        {
          "description": "event: 事件流推送帧，包含完整的事件模型",
          "$ref": "#/$defs/Event"
        },
        {
          "description": "checkpoint: 检查点帧。服务端向客户端下发的已发送事件边界通知（代表服务端发送边界，并非消费者确认接收回执）。补读结束追平高水位或定期同步时发送，告知客户端当前已发送的安全游标",
          "required": ["kind", "tacoId", "cursor"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "checkpoint" },
            "tacoId": { "$ref": "#/$defs/Uuid" },
            "cursor": { "$ref": "#/$defs/Sequence" }
          }
        },
        {
          "description": "error: 连接或协议错误帧。遇到非法首帧、游标失效或内部异常时推送并关闭连接",
          "required": ["kind", "error"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "error" },
            "error": { "$ref": "#/$defs/ErrorResponse/properties/error" }
          }
        }
      ],
      "examples": [
        {
          "kind": "ready",
          "protocol": "taco-host/1",
          "tacoId": "8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001",
          "cursor": "41",
          "mode": "live"
        },
        {
          "kind": "ready",
          "protocol": "taco-host/1",
          "tacoId": "8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001",
          "cursor": "30",
          "mode": "replay",
          "replayThrough": "41"
        },
        {
          "kind": "checkpoint",
          "tacoId": "8e8e2b51-4cad-43d2-a5f6-4f56bcb0a001",
          "cursor": "42"
        },
        {
          "kind": "error",
          "error": {
            "code": "CURSOR_EXPIRED",
            "message": "Cursor has expired and cannot be replayed",
            "retryable": false,
            "requestId": "ws_req_001",
            "details": {
              "earliestAvailableSequence": "100"
            }
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "description": "统一标准结构化错误响应体。HTTP 错误响应（4xx/5xx）与 WebSocket error 帧均使用此格式。机器可读的稳定 code 与人类可读的 message 分离，不包含密钥或完整正文",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable", "requestId"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$",
              "description": "机器可识别的稳定错误代码，如 VALIDATION_ERROR、UNAUTHORIZED、FORBIDDEN、NOT_FOUND、REVISION_CONFLICT、IDEMPOTENCY_MISMATCH、CURSOR_EXPIRED、PAYLOAD_TOO_LARGE、RATE_LIMITED、TACO_CLOSED 等",
              "examples": ["REVISION_CONFLICT", "CURSOR_EXPIRED", "IDEMPOTENCY_MISMATCH"]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "清晰的错误描述信息（英文或多语言提示），指出问题原因"
            },
            "retryable": {
              "type": "boolean",
              "description": "指示客户端是否可以自动重试。仅对网络瞬断、429 限流及明确的 5xx 临时故障为 true；400、401、403、409、422 等确定性错误为 false"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "description": "用于链路追踪与日志对齐的不透明请求 ID，不一定是 UUID"
            },
            "details": {
              "type": "object",
              "description": "可选的结构化上下文细节，如冲突的当前版本 ID、最早可恢复序号、字段校验失败位置等",
              "additionalProperties": true
            }
          }
        }
      },
      "examples": [
        {
          "error": {
            "code": "REVISION_CONFLICT",
            "message": "Base revision is no longer current",
            "retryable": false,
            "requestId": "req_123",
            "details": {
              "currentRevisionId": "993b05fd-2f80-48cc-aafd-1d7564781002"
            }
          }
        },
        {
          "error": {
            "code": "CURSOR_EXPIRED",
            "message": "Requested cursor sequence 10 is too old; earliest available sequence is 50",
            "retryable": false,
            "requestId": "req_456",
            "details": {
              "earliestAvailableSequence": "50"
            }
          }
        }
      ]
    }
  }
}
