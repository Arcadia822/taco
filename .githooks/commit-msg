#!/usr/bin/env bash

# Git commit-msg hook to enforce Conventional Commits format
# Spec: https://www.conventionalcommits.org/

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Allow empty commits (git commit --allow-empty-message)
if [ -z "$FIRST_LINE" ]; then
  exit 0
fi

# Allow merge commits (e.g., "Merge branch ...", "Merge pull request ...")
if echo "$FIRST_LINE" | grep -qE '^Merge (branch|pull request|remote-tracking branch)'; then
  exit 0
fi

# Allow revert commits (e.g., "Revert ...")
if echo "$FIRST_LINE" | grep -qE '^Revert "'; then
  exit 0
fi

# Allow automated release tags/commits (e.g., "v1.0.0")
if echo "$FIRST_LINE" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+'; then
  exit 0
fi

# Conventional Commits regex pattern
# type(scope?)!?: subject
CONVENTIONAL_PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_.-]+\))?(!)?:[[:space:]].+$'

if ! echo "$FIRST_LINE" | grep -qE "$CONVENTIONAL_PATTERN"; then
  echo ""
  echo "❌ Error: Commit message does not follow Conventional Commits format."
  echo ""
  echo "  Your commit message was:"
  echo "    \"$FIRST_LINE\""
  echo ""
  echo "  Expected format:"
  echo "    <type>(<scope?>)(!?): <subject>"
  echo ""
  echo "  Allowed types:"
  echo "    feat     - A new feature (triggers MINOR version bump)"
  echo "    fix      - A bug fix (triggers PATCH version bump)"
  echo "    perf     - Performance improvement (triggers PATCH version bump)"
  echo "    docs     - Documentation changes"
  echo "    style    - Code style/formatting changes"
  echo "    refactor - Code refactoring without feature or bug fix"
  echo "    test     - Adding or modifying tests"
  echo "    build    - Build system or dependency updates"
  echo "    ci       - CI configuration and script updates"
  echo "    chore    - Other maintenance and tooling tasks"
  echo "    revert   - Reverting a previous commit"
  echo ""
  echo "  Breaking changes:"
  echo "    Append '!' before ':' or include 'BREAKING CHANGE:' in body"
  echo "    Example: feat(kernel)!: redesign document format (triggers MAJOR bump)"
  echo ""
  echo "  Examples:"
  echo "    feat(host): add landing page animation (#49)"
  echo "    fix(cli): correct self-description output"
  echo "    docs(agents): document semantic commit requirements"
  echo "    chore(release): bump taco-cli to 0.1.5"
  echo ""
  exit 1
fi

exit 0
