{
  "name": "taco",
  "private": true,
  "version": "0.10.0",
  "description": "A single-file workspace for humans and agents to review, hand off, and manage software specs.",
  "license": "MIT",
  "author": "Arcadia",
  "homepage": "https://github.com/Arcadia822/taco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcadia822/taco.git"
  },
  "bugs": {
    "url": "https://github.com/Arcadia822/taco/issues"
  },
  "keywords": [
    "spec-kit",
    "markdown",
    "local-first",
    "single-file"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "taco": "extensions/taco/bin/taco.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-shells.mjs && node scripts/refresh-host-demo.mjs",
    "build:single": "npm run build",
    "format": "prettier --write README.md README.zh-CN.md AGENTS.md docs/agent-installation.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md package.json .github",
    "format:check": "prettier --check README.md README.zh-CN.md AGENTS.md docs/agent-installation.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md package.json .github",
    "check": "npm run format:check && npm test && npm run build",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "mermaid": "^12.0.0",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.1.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code": "3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dompurify": "^3.4.13",
    "lowlight": "^3.3.0",
    "marked": "^18.0.9",
    "yaml": "^2.9.0"
  }
}
